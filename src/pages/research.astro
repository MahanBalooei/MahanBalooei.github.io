---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Research in protein language models, variant-effect prediction, computational genomics, and machine learning for biological data.",
	title: "Research",
};

interface Project {
	title: string;
	subtitle: string;
	description: string[];
	methods: string[];
	repo?: string;
}

const proteinProjects: Project[] = [
	{
		title: "Protein Language Model-Based Signal Peptide Prediction",
		subtitle: "Comparing classical statistical methods, SVMs, CNN-BiLSTM, and ESM-2 embeddings",
		description: [
			"Built an end-to-end pipeline for eukaryotic signal-peptide prediction using high-confidence UniProtKB/Swiss-Prot annotations, with MMseqs2 clustering used to reduce sequence redundancy and construct biologically meaningful train/benchmark splits.",
			"Compared the von Heijne position-specific weight matrix, a biochemical-feature SVM, a CNN-BiLSTM sequence model, and an ESM-2 embedding-based model. The ESM-2-based model achieved F1 = 0.962 and MCC = 0.957 on a held-out benchmark. The project also examined amino-acid composition, signal-peptide lengths, kingdom-specific bias, and cleavage-site motifs for biological interpretation.",
		],
		methods: ["Python", "PyTorch", "ESM-2", "MMseqs2", "scikit-learn"],
		repo: "https://github.com/MahanBalooei/eukaryotic-signal-peptide-prediction",
	},
	{
		title: "Protein Domain and Functional Annotation Using HMMER and MMseqs2",
		subtitle: "Profile HMMs versus sequence-similarity search for protein-domain annotation",
		description: [
			"Built an automated protein-domain annotation workflow using profile HMMs, HMMER, and MMseqs2 for large-scale sequence classification, processing structure-derived protein alignments to support domain-level annotation and sequence-based functional inference.",
			"Compared profile-based and sequence-similarity-based classification workflows, achieving MCC = 0.997 and MCC = 0.991, respectively. The project connects classical homology and profile-HMM methods to modern protein representation-learning problems such as remote homology detection and protein-family classification.",
		],
		methods: ["HMMER", "MMseqs2", "Python", "Bash"],
		repo: "https://github.com/MahanBalooei/HMM_KunitzDomain",
	},
];

const otherProjects: Project[] = [
	{
		title: "Computational Epigenomics Analysis of DNA Methylation (Illumina 450K)",
		subtitle: "Differential methylation analysis in R/Bioconductor",
		description: [
			"Conducted an R/Bioconductor workflow for Illumina 450K DNA methylation-array analysis, including quality control, normalization, PCA-based batch-effect assessment, and differential methylation analysis. Identified differentially methylated regions and visualized methylation patterns using heatmaps, volcano plots, and exploratory statistical summaries.",
		],
		methods: ["R", "Bioconductor", "minfi"],
		repo: "https://github.com/MahanBalooei/epigenetic-methylation-450k",
	},
	{
		title: "Chest X-Ray Pneumonia Detection via Transfer Learning",
		subtitle: "Benchmarking ResNet50, EfficientNetB0, and DenseNet-121 XRV under class imbalance",
		description: [
			"Compared ResNet50, EfficientNetB0, and DenseNet-121 XRV for pneumonia classification under class imbalance. Evaluated threshold selection, ensembling, test-time augmentation, and Grad-CAM interpretability; DenseNet-121 XRV achieved the strongest performance under the maximum-MCC strategy.",
		],
		methods: ["PyTorch", "TensorFlow", "Grad-CAM"],
		repo: "https://github.com/MahanBalooei/chest-xray-pneumonia-detection",
	},
];
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Research</h1>

	<section>
		<h2 class="title text-accent mb-6 text-lg">Current Thesis Research</h2>
		<article>
			<h3 class="text-base font-semibold sm:text-lg">
				Protein Language Models for Human Protein Variant Pathogenicity Prediction
			</h3>
			<p class="text-muted mt-1 text-sm italic">
				MSc Thesis · University of Bologna · Ongoing
			</p>
			<div class="prose prose-sm prose-cactus mt-3 max-w-none">
				<p>
					My MSc thesis focuses on modernizing the E-SNPs&amp;GO framework for predicting whether human
					missense variants are pathogenic or benign. The project centers on updating the human
					variant datasets used by the original framework and evaluating contemporary protein
					language-model representations for variant-effect prediction.
				</p>
				<p>
					The work is currently in progress and includes reviewing newer variant-effect methods and
					protein language models to establish appropriate modern baselines and modelling directions.
				</p>
			</div>
			<p class="mt-3 text-sm">
				<span class="font-semibold">Supervisors: </span>
				Castrense Savojardo · Pier Luigi Martelli · Matteo Manfredi
			</p>
		</article>
	</section>

	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-lg">Protein &amp; Sequence Modelling</h2>
		<div class="space-y-12">
			{
				proteinProjects.map((p) => (
					<article>
						<h3 class="text-base font-semibold sm:text-lg">{p.title}</h3>
						<p class="text-muted mt-1 text-sm italic">{p.subtitle}</p>
						<div class="prose prose-sm prose-cactus mt-3 max-w-none">
							{p.description.map((para) => (
								<p>{para}</p>
							))}
						</div>
						<p class="mt-3 text-sm">
							<span class="font-semibold">Methods: </span>
							{p.methods.map((m, i) => (
								<>
									<code>{m}</code>
									{i < p.methods.length - 1 && " · "}
								</>
							))}
						</p>
						{p.repo && (
							<p class="mt-1 text-sm">
								<span class="font-semibold">Code: </span>
								<a class="cactus-link" href={p.repo} rel="noreferrer" target="_blank">
									{p.repo.replace("https://", "")}
								</a>
							</p>
						)}
					</article>
				))
			}
		</div>
	</section>

	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-lg">Other Computational Biology</h2>
		<div class="space-y-10">
			{
				otherProjects.map((p) => (
					<article>
						<h3 class="text-sm font-semibold sm:text-base">{p.title}</h3>
						<p class="text-muted mt-1 text-xs italic sm:text-sm">{p.subtitle}</p>
						<div class="prose prose-sm prose-cactus mt-2 max-w-none">
							{p.description.map((para) => (
								<p>{para}</p>
							))}
						</div>
						<p class="mt-2 text-xs sm:text-sm">
							<span class="font-semibold">Methods: </span>
							{p.methods.map((m, i) => (
								<>
									<code>{m}</code>
									{i < p.methods.length - 1 && " · "}
								</>
							))}
						</p>
						{p.repo && (
							<p class="mt-1 text-xs sm:text-sm">
								<span class="font-semibold">Code: </span>
								<a class="cactus-link" href={p.repo} rel="noreferrer" target="_blank">
									{p.repo.replace("https://", "")}
								</a>
							</p>
						)}
					</article>
				))
			}
		</div>
	</section>
</PageLayout>
