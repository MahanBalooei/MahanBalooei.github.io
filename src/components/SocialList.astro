---
import { Icon } from "astro-icon/components";

const socialLinks: {
	friendlyName: string;
	link: string;
	name: string;
}[] = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/MahanBalooei",
		name: "mdi:github",
	},
	{
		friendlyName: "LinkedIn",
		link: "https://www.linkedin.com/in/mahan-balooei/",
		name: "mdi:linkedin",
	},
	{
		friendlyName: "Email",
		link: "mailto:mahan.balooei@studio.unibo.it",
		name: "mdi:email-outline",
	},
	{
		friendlyName: "Download PDF CV",
		link: "/cv/CV_Mahan_Balooei.pdf",
		name: "mdi:file-pdf-box",
	},
];
---

<div class="flex flex-wrap items-end gap-x-2">
	<ul class="flex flex-1 items-center gap-x-2 sm:flex-initial" role="list">
		{
			socialLinks.map(({ friendlyName, link, name }) => (
				<li class="flex">
					<a
						class="hover:text-link inline-block"
						href={link}
						rel="noreferrer"
						target={link.startsWith("mailto:") ? undefined : "_blank"}
					>
						<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name={name} />
						<span class="sr-only">{friendlyName}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>
